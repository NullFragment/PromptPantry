{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mealPlan.schema.json",
  "title": "MealPlan",
  "description": "Compact meal plan storage format - stores recipe references, not full recipe data",
  "type": "object",
  "patternProperties": {
    "^\\d{4}-\\d{2}-\\d{2}$": {
      "type": "object",
      "properties": {
        "breakfast": {
          "$ref": "#/$defs/mealSlots"
        },
        "lunch": {
          "$ref": "#/$defs/mealSlots"
        },
        "dinner": {
          "$ref": "#/$defs/mealSlots"
        },
        "snacks": {
          "$ref": "#/$defs/mealSlots"
        },
        "drinks": {
          "$ref": "#/$defs/mealSlots"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mealSlots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mealSlot"
      }
    },
    "mealSlot": {
      "type": "object",
      "properties": {
        "recipeName": {
          "type": "string",
          "description": "Name of the recipe (used to look up full recipe data)"
        },
        "servings": {
          "type": "number",
          "minimum": 0
        },
        "participant": {
          "type": "string"
        },
        "recipeInstanceId": {
          "type": "string",
          "description": "UUID linking this meal to a specific instance in the weekly cook plan"
        }
      },
      "required": [
        "recipeName",
        "servings"
      ],
      "additionalProperties": false
    }
  }
}
